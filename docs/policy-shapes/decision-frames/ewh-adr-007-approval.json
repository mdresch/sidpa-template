{
  "task": "ADR-007 (10-Strategy PMBOK Risk Response Taxonomy & Multi-Criteria Recommender): approve, reject, or request revision under PMP-BL-v1.0.0",
  "criteria": [
    {
      "id": "architectural_soundness",
      "weight": 1.0,
      "minimum_sources": 1,
      "description": "Expands legacy 4-strategy risk model to 10 PMBOK canonical strategies (5 threat responses: Escalate, Avoid, Transfer, Mitigate, Accept; 5 opportunity responses: Escalate, Exploit, Share, Enhance, Accept), paired with a 6-criteria multi-attribute utility recommendation engine."
    },
    {
      "id": "alternatives_considered",
      "weight": 1.0,
      "minimum_sources": 1,
      "description": "Three real alternatives named and rejected: retaining 4 basic threat strategies (omits positive risk exploitation and formal executive escalation), unweighted heuristic rules (produces non-optimal trade-offs between cost and risk reduction), black-box LLM prompt scoring without mathematical framing (non-deterministic, non-reproducible governance recommendations)."
    },
    {
      "id": "consequences_honest",
      "weight": 1.0,
      "minimum_sources": 1,
      "description": "Consequences accurately acknowledge that risk managers must specify expected monetary value (EMV) and strategy cost inputs for the recommender to compute optimal utility."
    },
    {
      "id": "gap_disclosure_quality",
      "weight": 1.0,
      "minimum_sources": 1,
      "description": "Closes gap identified in HYP-ewh-003 and SC-03, elevating risk management from a passive register to an active decision-support system."
    }
  ],
